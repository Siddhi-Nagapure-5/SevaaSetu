generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String // "DONOR" | "RECEIVER" | "ADMIN"
  kycStatus String   @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  createdAt DateTime @default(now())

  donations Donation[]
  needs     Need[]
}

model Donation {
  id          String   @id @default(uuid())
  donorId     String
  category    String
  title       String
  description String
  quantity    String
  images      String // JSON array of image paths
  status      String   @default("PENDING_REVIEW") // "PENDING_REVIEW" | "APPROVED" | "MATCHED"
  createdAt   DateTime @default(now())

  donor   User    @relation(fields: [donorId], references: [id])
  matches Match[]
}

model Need {
  id          String   @id @default(uuid())
  receiverId  String
  category    String
  title       String
  goal        String
  description String
  city        String
  state       String
  urgency     String
  status      String   @default("PENDING_REVIEW") // "PENDING_REVIEW" | "APPROVED" | "FULFILLED"
  createdAt   DateTime @default(now())

  receiver User    @relation(fields: [receiverId], references: [id])
  matches  Match[]
}

model Match {
  id         String   @id @default(uuid())
  needId     String
  donationId String
  status     String   @default("PENDING_ADMIN_APPROVAL") // "PENDING_ADMIN_APPROVAL" | "APPROVED" | "COMPLETED"
  matchScore Int
  createdAt  DateTime @default(now())

  need     Need     @relation(fields: [needId], references: [id])
  donation Donation @relation(fields: [donationId], references: [id])
}
